{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PureRGB",
  "version": "0.52.2",
  "identifier": "org.heiphaistos.purergb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PureRGB",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": [
      "resources/openrgb/**/*",
      "resources/liquidctl/**/*",
      "resources/sensord/**/*",
      "resources/drivers/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": { "cmd": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign-windows.ps1", "%1"] },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["French", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNzU2MUI4RjM0ODk4NjcKUldSbm1Fanp1R0YxdzhvTXgrdGI2Nzl5MFh3Rmt5cFViek1EaVcwNTAvb0FiMFF2VmxvZFJpRWMK",
      "endpoints": ["https://github.com/Heiphaistos/PureRGB/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
